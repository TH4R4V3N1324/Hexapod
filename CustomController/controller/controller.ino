const int NUM_ITEMS = 4;

// Array of all bitmaps for convenience. (Total bytes used to store images in PROGMEM = 144)
const unsigned char* icons[NUM_ITEMS] = {
	epd_bitmap_cog_icon,
	epd_bitmap_controller_icon,
	epd_bitmap_paw_icon,
  epd_bitmap_home_icon
};

char menu_item[] [20] = {
  {"Config"},
	{"Mode"},
	{"Gait"},
  {"Home Screen"}
};

int item_selected = 0;
int item_previous;
int item_next;

enum EncoderStates {AB, Ab, aB, ab};
EncoderStates encoderState;
int encoderCounter = 0;

void setup() {
  pinMode(upButton, INPUT_PULLUP);
  pinMode(selectButton, INPUT_PULLUP);
  pinMode(downButton, INPUT_PULLUP);
  pinMode(encoderButton, INPUT_PULLUP);

  u8g2.begin();
  u8g2.setFont(u8g2_font_5x8_mn);
  u8g2.setColorIndex(1);
}

void loop() {
  encoderFSM();
  Serial.println(encoderCounter);

  if(digitalRead(upButton) == LOW) {
    item_selected -= 1;
    if (item_selected < 0) item_selected = NUM_ITEMS - 1;
  }

  if(digitalRead(downButton) == LOW) {
    item_selected += 1;
    if (item_selected >= NUM_ITEMS) item_selected = 0;
  }

  item_previous = item_selected - 1;
  if (item_previous < 0) item_previous = NUM_ITEMS - 1;
  item_next = item_selected + 1;
  if (item_next >= NUM_ITEMS) item_next = 0;

  u8g2.firstPage();
  do {
    u8g2.drawXBMP(0, 22, 128, 21, epd_bitmap_selected_outline);

    // Previous
    u8g2.setFont(u8g_font_7x14);
    u8g2.drawStr(26, 15, menu_item[item_previous]);
    u8g2.drawXBMP(4, 2, 16, 16, icons[item_previous]);

    // Current
    u8g2.setFont(u8g_font_7x14B);
    u8g2.drawStr(26, 37, menu_item[item_selected]);
    u8g2.drawXBMP(4, 24, 16, 16, icons[item_selected]);

    // Next
    u8g2.setFont(u8g_font_7x14);
    u8g2.drawStr(26, 59, menu_item[item_next]);
    u8g2.drawXBMP(4, 46, 16, 16, icons[item_next]);

  } while ( u8g2.nextPage() );
}

void encoderFSM() {
  switch (encoderState) {
    case AB:
      if (!digitalRead(encoderA)) {encoderState = aB; encoderCounter ++;}
      if (!digitalRead(encoderB)) {encoderState = Ab; encoderCounter --;}
      break;
    case aB:
      if (!digitalRead(encoderB)) {encoderState = ab; encoderCounter ++;}
      if (digitalRead(encoderA)) {encoderState = AB; encoderCounter --;}
      break;
    case Ab:
      if (digitalRead(encoderB)) {encoderState = AB; encoderCounter ++;}
      if (!digitalRead(encoderA)) {encoderState = ab; encoderCounter --;}
      break;
    case ab:
      if (digitalRead(encoderA)) {encoderState = Ab; encoderCounter ++;}
      if (digitalRead(encoderB)) {encoderState = aB; encoderCounter --;}
      break;
    default:
      printf("invalid state");
      break;
  }
}

void initializeEncoder() {
  if (digitalRead(encoderA) && digitalRead(encoderB)) encoderState = AB;
  if (!digitalRead(encoderA) && digitalRead(encoderB)) encoderState = aB;
  if (digitalRead(encoderA) && !digitalRead(encoderB)) encoderState = Ab;
  if (!digitalRead(encoderA) && !digitalRead(encoderB)) encoderState = ab;
}